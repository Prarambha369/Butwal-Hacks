# ═══════════════════════════════════════════════════════════════════
# BUTWAL HACKS — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy to .env.local and fill in values.
#   cp .env.example .env.local
#
# Required = app breaks without this
# Optional = feature degrades gracefully
# CI Only = only needed in GitHub Actions or Vercel CI
# ═══════════════════════════════════════════════════════════════════

# ─── Supabase (Database) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=            # Required — Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Required — Supabase anon/public key
SUPABASE_SERVICE_ROLE_KEY=           # Required — Service role key (server-only)
SUPABASE_DB_URL=                     # CI Only — Direct DB connection for migrations

# ─── Auth0 (Authentication) ────────────────────────────────────────
AUTH0_SECRET=                        # Required — openssl rand -hex 32
AUTH0_DOMAIN=                        # Required — e.g. auth.butwalhacks.com
AUTH0_CLIENT_ID=                     # Required — Regular Web App client ID
AUTH0_CLIENT_SECRET=                 # Required — Regular Web App client secret
AUTH0_BASE_URL=                      # Required — http://localhost:3000 or https://app.butwalhacks.com
AUTH0_WEBHOOK_SECRET=                # Required — Auth0 webhook signing secret

# ─── Auth0 M2M (Management API) ────────────────────────────────────
AUTH0_M2M_CLIENT_ID=                 # Required — M2M app client ID
AUTH0_M2M_CLIENT_SECRET=             # Required — M2M app client secret
AUTH0_MANAGEMENT_API_AUDIENCE=       # Optional — Management API audience (tenant's real API identifier, e.g. https://butwal.jp.auth0.com/api/v2/). Defaults to https://<AUTH0_DOMAIN>/api/v2/.

# ─── Cloudinary (Media CDN) ───────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=   # Required — Cloudinary cloud name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET= # Required — Upload preset
CLOUDINARY_API_KEY=                  # Required — API key for signatures
CLOUDINARY_API_SECRET=               # Required — API secret

# ─── Resend (Email) ────────────────────────────────────────────────
RESEND_API_KEY=                      # Optional — Contact form, claim emails, alerts

# ─── Groq AI (only AI provider) ─────────────────────────────────────
GROQ_API_KEY=                        # Optional — BH Bot chat, pitch generator, summaries, OCR

# (Removed: HF_API_TOKEN — vector embeddings disabled, Groq-only mode)

# ─── PostHog (Analytics) ──────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=   # Optional — Product analytics
NEXT_PUBLIC_POSTHOG_HOST=            # Optional — Defaults to https://us.i.posthog.com

# ─── Sentry (Error Tracking) ──────────────────────────────────────
SENTRY_DSN=                          # Optional — Server-side error tracking
NEXT_PUBLIC_SENTRY_DSN=              # Optional — Client-side error tracking
SENTRY_ORG=                          # CI Only — Org slug
SENTRY_PROJECT=                      # CI Only — Project slug
SENTRY_AUTH_TOKEN=                   # CI Only — Auth token for source maps

# ─── Upstash Redis (Rate Limiting) ────────────────────────────────
UPSTASH_REDIS_REST_URL=              # Optional — Rate limiting and cache
UPSTASH_REDIS_REST_TOKEN=            # Optional — REST API token

# ─── Webhooks & Notifications ─────────────────────────────────────
SLACK_WEBHOOK_URL=                   # Optional — Error alerts to Slack
DISCORD_WEBHOOK_URL=                 # Optional — Discord notifications
OC_WEBHOOK_SECRET=                   # Optional — Open Collective verification
CONTACT_EMAIL=                       # Optional — Defaults to hello@butwalhacks.com

# ─── Trust Marker Crypto (Ed25519) ────────────────────────────────
# Generate with: node -e "const {generateKeyPairSync}=require('crypto');
#   const {privateKey,publicKey}=generateKeyPairSync('ed25519',{
#   privateKeyEncoding:{type:'pkcs8',format:'pem'},
#   publicKeyEncoding:{type:'spki',format:'pem'}});
#   console.log('TRUST_MARKER_PRIVATE_KEY='+privateKey.replace(/\n/g,'\\n'));
#   console.log('TRUST_MARKER_PUBLIC_KEY='+publicKey.replace(/\n/g,'\\n'));"
# TRUST_MARKER_PRIVATE_KEY=          # Optional — PEM for signing
# TRUST_MARKER_PUBLIC_KEY=           # Optional — PEM for verifying

# ─── App URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=                # Optional — Defaults to https://butwalhacks.com
NEXT_PUBLIC_APP_URL=                 # Optional — Defaults to https://app.butwalhacks.com

# ─── E2E Testing (Playwright) ─────────────────────────────────────
AUTH0_TEST_EMAIL=                    # CI Only — Playwright test user
AUTH0_TEST_PASSWORD=                 # CI Only — Playwright test password

# ─── CI/CD ─────────────────────────────────────────────────────────
VERCEL_DEPLOY_HOOK_URL=              # CI Only — GitHub secret, not in .env.local

# ─── Google Calendar sync (calendar.butwalhacks.com) ───────────────
# Server-only. NEVER prefix with NEXT_PUBLIC_.
# Create in Google Cloud Console -> APIs & Services -> Credentials.
# The redirect URI must be exactly:
#   ${CALENDAR_BASE_URL}/api/calendar/google/callback
# The scope requested is calendar.events.owned, a SENSITIVE scope, so Google
# requires OAuth verification (app name, privacy policy, demo video) before
# any other user can connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_BASE_URL=                   # Optional — Defaults to https://calendar.butwalhacks.com
# Secret for the scheduled background sync (api/calendar/google/cron).
# Must be at least 32 chars. Generate: openssl rand -hex 32
CRON_SECRET=
