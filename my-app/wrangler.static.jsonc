// Static marketing site (butwalhacks.com) on Cloudflare Workers static assets.
//
// Assets only: there is no "main" script, so no Worker code runs per request.
// Requests for static assets are free and unlimited on Workers Free and use no
// CPU, and _redirects/_headers in the output are applied by Cloudflare itself.
// The app (auth, dashboards, API) stays on Vercel at app.butwalhacks.com.
//
// Build: `npm run static:build` (scripts/build-static.mjs → ../.static-build/out)
// Deploy the preview: `npm run static:deploy:preview`. See docs/CLOUDFLARE.md.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "butwal-hacks-site",
  "compatibility_date": "2026-11-20",
  // No routes or custom domains here; the owner attaches butwalhacks.com and
  // www at cutover.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../.static-build/out",
    // /about serves about.html; /about/ redirects to /about.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get the exported 404 page with a 404 status.
    "not_found_handling": "404-page"
  },
  "env": {
    // "butwal-hacks-site-preview" on butwal-hacks-site-preview.butwalhacks.workers.dev
    "preview": {
      "workers_dev": true,
      "preview_urls": false
    }
  }
}
