{
  "name": "butwal-hacks",
  "private": true,
  "workspaces": [
    "my-app"
  ],
  "scripts": {
    "dev": "cd my-app && npm run dev",
    "build": "cd my-app && npm run build",
    "start": "cd my-app && npm run start",
    "lint": "cd my-app && npm run lint",
    "test": "cd my-app && npm run test",
    "typecheck": "cd my-app && npm run typecheck",
    "prepare": "[ -d .git ] && git config core.hooksPath .husky/ || true"
  },
  "overrides": {
    "postcss": "^8.5.19",
    "sharp": "^0.35.5",
    "js-yaml": "4.3.2",
    "dompurify": "3.4.17",
    "source-map-js": "1.2.2",
    "nanoid": "3.3.19",
    "brace-expansion@1.1.15": "1.1.18",
    "brace-expansion@2.1.1": "2.1.4",
    "brace-expansion@5.0.7": "5.0.9"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.25.0"
  },
  "allowScripts": {
    "@sentry/cli": true,
    "unrs-resolver": true
  },
  "devDependencies": {}
}
