# Butwal Hacks — Environment Variables
# Copy to .env.local (dev) or configure in Vercel (prod). NEVER commit real secrets.
# NEXT_PUBLIC_* → client bundle. Everything else → server-only.

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_SECRET=replace-with-64-hex-chars
APP_BASE_URL=http://localhost:3000
AUTH0_M2M_CLIENT_ID=your_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_m2m_client_secret
AUTH0_MANAGEMENT_API_AUDIENCE=https://your-tenant.auth0.com/api/v2/
AUTH0_WEBHOOK_SECRET=replace-with-64-hex-chars
# Legacy alias; APP_BASE_URL wins when both are set.
AUTH0_BASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Integration-provisioned aliases (Vercel Supabase addon sets these).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token

# Groq
GROQ_API_KEY=your_groq_api_key

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://public@your-org.ingest.us.sentry.io/your-project
SENTRY_DSN=https://public@your-org.ingest.us.sentry.io/your-project
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Trust marker signing (Ed25519)
TRUST_MARKER_PRIVATE_KEY=replace-with-pkcs8-pem-private-key
TRUST_MARKER_PUBLIC_KEY=replace-with-spki-pem-public-key

# Email & notifications
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL=hello@butwalhacks.com
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_EMAIL_CHANNEL=#emails

# Open Collective webhook
OC_WEBHOOK_SECRET=replace-with-64-hex-chars

# Public URLs
NEXT_PUBLIC_SITE_URL=https://butwalhacks.com
NEXT_PUBLIC_APP_URL=https://app.butwalhacks.com
# Google Calendar OAuth (per-organizer connect flow)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Public origin the Google OAuth redirect URI is built from.
CALENDAR_BASE_URL=https://app.butwalhacks.com

# CI / runtime
NODE_ENV=development
VERCEL_GIT_COMMIT_SHA=
# Shared secret for cron-invoked routes. KEEP_ALIVE_SECRET is the
# primary name; CRON_SECRET is accepted as a fallback.
KEEP_ALIVE_SECRET=
CRON_SECRET=
