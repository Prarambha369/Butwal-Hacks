# ═══════════════════════════════════════════════════════════════════════
# Butwal Hacks — Environment Variables
#
# Copy this file to `.env.local` (development) or configure these in
# Vercel (production) and fill in real values. NEVER commit real secrets.
#
# Naming convention:
#   NEXT_PUBLIC_*  → bundled into the client bundle. Safe to expose,
#                    but must NOT grant privileged access.
#   Everything else → server-only. Never reference from client code.
# ═══════════════════════════════════════════════════════════════════════

# ─── Auth0 (server) ────────────────────────────────────────────────
# Auth0 tenant + application. The SPA/Regular Web App credentials.
# https://manage.auth0.com/dashboard/<tenant>/applications
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
# Long random string (>=32 chars) used to encrypt session cookies.
# Generate with: openssl rand -hex 32
AUTH0_SECRET=replace-with-64-hex-chars
# Base URL of the app. Dev: http://localhost:3000 — Prod: https://butwalhacks.com
# (SDK v4 uses APP_BASE_URL; AUTH0_BASE_URL accepted as a fallback.)
APP_BASE_URL=http://localhost:3000
# Optional: AUTH0_BASE_URL=http://localhost:3000

# Auth0 Machine-to-Machine app with Management API access
# (used by admin scripts / CI verification).
AUTH0_M2M_CLIENT_ID=your_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_m2m_client_secret
AUTH0_MANAGEMENT_API_AUDIENCE=https://your-tenant.auth0.com/api/v2/

# Secret for verifying Auth0 webhook payloads (e.g. /api/webhooks/auth0).
# Generate with: openssl rand -hex 32
AUTH0_WEBHOOK_SECRET=replace-with-64-hex-chars

# ─── Supabase (database) ───────────────────────────────────────────
# Project URL — https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon/public key — safe for client use, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SERVICE ROLE KEY — full database access, bypasses RLS. SERVER-ONLY.
# Never expose in the client bundle or commit to the repo.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Cloudinary (media uploads) ────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
# Server-side keys for generating upload signatures (/api/cloudinary-signature).
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Upstash Redis (rate limiting + cache) ─────────────────────────
# https://console.upstash.com/redis → REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token

# ─── AI / ML (Groq only) ────────────────────────────────────────────
# Groq API key for BH Bot chat, pitch generator, summaries, OCR.
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# (Removed: HF_API_TOKEN — vector embeddings disabled in Groq-only mode)

# ─── PostHog (product analytics) ───────────────────────────────────
# https://us.posthog.com/project/<id>/settings/overview
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Sentry (error monitoring) ─────────────────────────────────────
# https://sentry.io/settings/<org>/projects/<project>/keys
NEXT_PUBLIC_SENTRY_DSN=https://public@your-org.ingest.us.sentry.io/your-project
SENTRY_DSN=https://public@your-org.ingest.us.sentry.io/your-project
# Build-time only (source map uploads):
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ─── Trust marker signing (Ed25519) ────────────────────────────────
# Keypair used to sign trust markers. Generate:
#   node -e "const {generateKeyPairSync, createPrivateKey, createPublicKey}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('ed25519');console.log('TRUST_MARKER_PRIVATE_KEY='+createPrivateKey(privateKey).export({type:'pkcs8',format:'pem'}).replace(/\n/g,'\\n'));console.log('TRUST_MARKER_PUBLIC_KEY='+createPublicKey(publicKey).export({type:'spki',format:'pem'}).replace(/\n/g,'\\n'))"
# PEM with literal \n escapes (see my-app/src/lib/crypto-sign.ts).
# Placeholder below — replace with your real PKCS#8 PEM content,
# line breaks escaped as \\n.
TRUST_MARKER_PRIVATE_KEY=replace-with-pkcs8-pem-private-key
TRUST_MARKER_PUBLIC_KEY=replace-with-spki-pem-public-key

# ─── Email & notifications ──────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
# Address used as the sender/reply target for the contact form.
CONTACT_EMAIL=hello@butwalhacks.com
# Discord webhook for the community bot.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Slack incoming-webhook (ops alerts) + channel for email digests.
# Point SLACK_EMAIL_CHANNEL at a channel email address (e.g. the
# #feedback-from-site address) and anything emailed there auto-posts.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_EMAIL_CHANNEL=#emails

# ─── Open Collective webhook ───────────────────────────────────────
# Verify OC payloads at /api/webhooks/opencollective. Generate:
#   openssl rand -hex 32
OC_WEBHOOK_SECRET=replace-with-64-hex-chars

# ─── Public URLs ───────────────────────────────────────────────────
# Marketing site (root domain) — used for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL=https://butwalhacks.com
# App subdomain — used for dashboard/auth links.
NEXT_PUBLIC_APP_URL=https://app.butwalhacks.com

# ─── CI / runtime (usually set by the platform) ────────────────────
NODE_ENV=development
VERCEL_GIT_COMMIT_SHA=