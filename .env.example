# ─── Butwal Hacks — Environment Variables ────────────────────────────
# Copy this file to my-app/.env.local and fill in your values.
#
#   cp .env.example my-app/.env.local
#
# Required services (free tier available for all):
#   Auth0, Supabase, Cloudinary, Upstash Redis, Resend
#
# Optional but recommended:
#   PostHog (analytics), Groq (AI), Axiom (logging)

# ─── Core App ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Auth0 (Authentication) ─────────────────────────────────────────
# Create a Regular Web Application at https://manage.auth0.com
#
# Auth0 SDK v4 mounts routes at /auth/* via proxy.ts middleware.
# The callback path is /auth/callback (NOT /api/auth/callback).
#
# Allowed Callback URLs: http://localhost:3000/auth/callback
# Allowed Logout URLs:   http://localhost:3000
# Allowed Web Origins:   http://localhost:3000
#
# Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_SECRET=a-long-random-64-char-hex-string
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_BASE_URL=http://localhost:3000
# AUTH0_WEBHOOK_SECRET=

# ─── Supabase (Database Only - Auth is handled by Auth0) ─────────────
# From Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Cloudinary (Media CDN) ─────────────────────────────────────────
# From Cloudinary Dashboard -> Settings -> API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=butwal_hacks_upload

# ─── Upstash Redis (Rate Limiting) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ─── Resend (Transactional Email) ────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
CONTACT_EMAIL=hello@butwalhacks.com

# ─── PostHog (Analytics) ────────────────────────────────────────────
# Optional - skip for local dev
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your-posthog-project-key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Groq AI ─────────────────────────────────────────────────────────
# Optional - only needed for AI features
# GROQ_API_KEY=gsk_your-groq-api-key

# ─── Axiom (Structured Logging) ──────────────────────────────────────
# Optional - logs fall back to console in dev
# AXIOM_TOKEN=your-axiom-personal-access-token
# AXIOM_DATASET=butwal-hacks

# ─── Cryptography (Trust Marker Signing - Ed25519) ───────────────────
# Generate with:
# node -e "const { generateKeyPairSync } = require('crypto');
# const { privateKey, publicKey } = generateKeyPairSync('ed25519', {
#   privateKeyEncoding: { type: 'pkcs8', format: 'pem' },
#   publicKeyEncoding:  { type: 'spki', format: 'pem' }
# });
# console.log(privateKey.replace(/\n/g, '\\n'));
# console.log(publicKey.replace(/\n/g, '\\n'));"
# TRUST_MARKER_PRIVATE_KEY=your-ed25519-private-key-pem
# TRUST_MARKER_PUBLIC_KEY=your-ed25519-public-key-pem

# ─── Sentry (Production Error Monitoring) ───────────────────────────
# Required for production. Create a project at https://sentry.io and
# copy the DSN. For local dev, Sentry initializes but samples at 0%.
# Options: SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN (for source maps)
SENTRY_DSN=https://your-dsn.ingest.us.sentry.io
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn.ingest.us.sentry.io

# ─── Cron (Scheduled Tasks) ──────────────────────────────────────────
# Generate CRON_SECRET with: openssl rand -hex 32
# CRON_SECRET=your-cron-secret

# ─── Webhook Proxies (Slack / Discord) ───────────────────────────────
# Optional - only needed for forwarding events to chat platforms
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
