NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://butwalhacks.com

# Supabase Edge Functions (@supabase/server SDK)
# Copy from Supabase Dashboard → Settings → API
SUPABASE_URL=your-supabase-url
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=your-jwks-url
RESEND_API_KEY=re_your-key
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
SIGNING_PRIVATE_KEY=base64-encoded-ed25519-pkcs8-pem
SIGNING_PUBLIC_KEY=base64-encoded-ed25519-spki-pem
CRON_SECRET=random-secret-for-cron-webhook-auth

# Groq AI API — Free tier at console.groq.com
# Used for AI-generated profile summaries (Phase 14)
GROQ_API_KEY=gsk_your-groq-api-key

# Axiom — Production log sink (Vercel-native)
# Sign up at https://axiom.co and create an API token + dataset
# - Axiom Vercel Integration: https://axiom.co/docs/integrations/vercel
# - Manual setup: create a dataset, generate a personal API token with ingest permission
# These are server-side env vars (no NEXT_PUBLIC_ prefix) — the logger runs only in
# API routes and server actions, never in the client bundle.
AXIOM_DATASET=butwal-hacks
AXIOM_TOKEN=xaat-your-axiom-api-token
