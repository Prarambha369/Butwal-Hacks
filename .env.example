# ─── Butwal Hacks — Environment Variables ────────────────────────────
# Copy this file to my-app/.env.local and fill in your values.
#
#   cp .env.example my-app/.env.local
#
# Required services (free tier available for all):
#   Auth0, Supabase, Cloudinary, Upstash Redis, Resend
#
# Optional but recommended:
#   PostHog (analytics), Groq (AI), Axiom (logging)

# ─── Core App ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://app.butwalhacks.com

# ─── Auth0 (Authentication) ─────────────────────────────────────────
# Create a Regular Web Application at https://manage.auth0.com
#
# Auth0 SDK v4 mounts routes at /auth/* via proxy.ts middleware.
# The callback path is /auth/callback (NOT /api/auth/callback).
#
# Allowed Callback URLs: http://localhost:3000/auth/callback
# Allowed Logout URLs:   http://localhost:3000
# Allowed Web Origins:   http://localhost:3000
#
# Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_SECRET=a-long-random-64-char-hex-string
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_BASE_URL=http://localhost:3000
# AUTH0_WEBHOOK_SECRET=your_auth0_webhook_secret

# ─── Auth0 M2M (CI Pipeline & Management API) ───────────────────────
# Create a Machine-to-Machine Application at https://manage.auth0.com
# Authorize it for Auth0 Management API with these scopes:
#   read:users update:users delete:users create:users
#   read:actions update:actions delete:actions create:actions
#
# Used by:
#   - CI pipeline (.github/workflows/ci.yml) for Auth0 health checks
#   - scripts/verify-auth0-m2m.mjs for manual verification
#   - lib/auth0-management.ts for identity linking (server-side)
#
# In CI (GitHub Actions), add these as repository secrets:
#   https://github.com/Prarambha369/Butwal-Hacks/settings/secrets/actions
AUTH0_M2M_CLIENT_ID=your_auth0_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_auth0_m2m_client_secret

# ─── Supabase (Database Only - Auth is handled by Auth0) ─────────────
# From Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER ONLY - DO NOT EXPOSE TO CLIENT
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Cloudinary (Media CDN) ─────────────────────────────────────────
# From Cloudinary Dashboard -> Settings -> API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=butwal_hacks_upload

# ─── Upstash Redis (Rate Limiting) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ─── Resend (Transactional Email) ────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
CONTACT_EMAIL=hello@butwalhacks.com

# ─── PostHog (Analytics) ────────────────────────────────────────────
# Optional - skip for local dev
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your-posthog-project-key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Groq AI ─────────────────────────────────────────────────────────
# Optional - only needed for AI features
# GROQ_API_KEY=your_groq_api_key

# ─── HuggingFace (AI Embeddings) ─────────────────────────────────────
# Required for AI vector search (pgvector embeddings).
# Get a free token at https://huggingface.co/settings/tokens
# HF_API_TOKEN=your_huggingface_api_token

# ─── Axiom (Structured Logging) ──────────────────────────────────────
# Optional - logs fall back to console in dev
# AXIOM_TOKEN=your-axiom-personal-access-token
# AXIOM_DATASET=butwal-hacks

# ─── Cryptography (Trust Marker Signing - Ed25519) ───────────────────
# Generate with:
# node -e "const { generateKeyPairSync } = require('crypto');
# const { privateKey, publicKey } = generateKeyPairSync('ed25519', {
#   privateKeyEncoding: { type: 'pkcs8', format: 'pem' },
#   publicKeyEncoding:  { type: 'spki', format: 'pem' }
# });
# console.log(privateKey.replace(/\n/g, '\\n'));
# console.log(publicKey.replace(/\n/g, '\\n'));"
# TRUST_MARKER_PRIVATE_KEY=your-ed25519-private-key-pem
# TRUST_MARKER_PUBLIC_KEY=your-ed25519-public-key-pem

# ─── Sentry (Production Error Monitoring) ───────────────────────────
# Required for production. Create a project at https://sentry.io and
# copy the DSN. For local dev, Sentry initializes but samples at 0%.
SENTRY_DSN=https://your-dsn.ingest.us.sentry.io
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn.ingest.us.sentry.io
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ─── Open Collective (Community Funding) ─────────────────────────────
# Webhook secret for verifying Open Collective event payloads.
# Set in Open Collective Dashboard > Webhooks.
# OC_WEBHOOK_SECRET=your-oc-webhook-secret

# ─── Cron (Scheduled Tasks) ──────────────────────────────────────────
# Generate CRON_SECRET with: openssl rand -hex 32
# CRON_SECRET=your-cron-secret

# ─── Webhook Proxies (Slack / Discord) ───────────────────────────────
# Optional - only needed for forwarding events to chat platforms
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_EMAIL_CHANNEL=your-slack-email-channel@incoming.slack.com

# ─── Vercel Deploy Hook (CI/CD) ──────────────────────────────────────
# Used by .github/workflows/deploy.yml to trigger production deploys.
# Create one in Vercel Dashboard -> Project Settings -> Git -> Deploy Hooks.
# Store this as a GitHub Action secret, NOT in .env.local.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/your-project-id/your-hook-id
